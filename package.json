{
  "name": "openagent",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "description": "OpenAgent: library + app, dynamic tools & provider abstraction (OpenCode-style)",
  "scripts": {
    "start": "node src/example.js",
    "task-example": "node src/task-example.js",
    "skill-example": "node src/skill-example.js",
    "langchain-example": "node langchain-example.js",
    "openclaw-weixin-example": "node src/openclaw-weixin-example.js",
    "weixin-login": "node src/weixin-ilink-login-cli.js",
    "app": "npm run start -w @openagent/app",
    "dev": "npm run dev -w @openagent/app",
    "build": "npm run build -w @openagent/core"
  },
  "workspaces": [
    "packages/*"
  ],
  "dependencies": {
    "qrcode-terminal": "^0.12.0"
  },
  "devDependencies": {
    "@langchain/core": "^0.3.0",
    "@langchain/langgraph": "^0.2.0",
    "@langchain/openai": "^0.3.0",
    "@tencent-weixin/openclaw-weixin": "^2.1.1",
    "zod": "^3.23.0"
  }
}
